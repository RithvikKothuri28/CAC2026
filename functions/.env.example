# Copy non-secret configuration to .env.<your-staging-project> during setup.
# Do not point automated tests at that project.
AI_ENABLED=false
AI_PROVIDER_ENDPOINT=
AI_MODEL=
AI_ALLOWED_HOSTS=
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=1000
AI_MIN_INTERVAL_SECONDS=5
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=500
# Secret AI_PROVIDER_KEY belongs in Firebase Secret Manager, never this file.
