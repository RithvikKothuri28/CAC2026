# Dart / Flutter build artefacts
.dart_tool/
build/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Generated code
*.g.dart
*.freezed.dart

# Firebase configuration generated by FlutterFire.
# App-level identifiers rather than private credentials, but they are
# environment-specific, so each machine regenerates its own.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Local environment. AI provider secrets must never live in the client.
.env
.env.*

# Editor and OS
.idea/
.vscode/
.DS_Store
